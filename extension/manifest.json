{
  "manifest_version": 2,
  "name": "Youtube Blocker",
  "version": "1.5.9",
  "description": "Erkennt unerwünschte YouTube-Inhalte am Titel, am Kanal und an der semantischen Übereinstimmung deiner Liste mit dem Inhalt des Vorschaubilds (lokales SigLIP, OCR) und sendet das Signal „Kein Interesse“.",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "*://*.youtube.com/*",
    "*://music.youtube.com/*",
    "*://*.ytimg.com/*",
    "*://*.googlevideo.com/*"
  ],
  "background": {
    "scripts": [
      "model-cache.js",
      "semantic-host.js",
      "ocr-host.js",
      "host-routes.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "lib/whisper.js",
        "matcher.js",
        "image.js",
        "semantic.js",
        "speech.js",
        "ocr.js",
        "dismiss.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "Youtube Blocker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-blocker@local.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  }
}
